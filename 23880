@Composable
fun GridLoveScreen(onNext: () -> Unit) {
    var errorText by remember { mutableStateOf("") }
    val selected = remember { mutableStateListOf<Int>() }

    Column(
        Modifier
            .fillMaxSize()
            .padding(20.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Text("Select all images with\nsomeone who loves you", 
            color = Color.White, fontSize = 20.sp, fontWeight = FontWeight.Bold, textAlign = TextAlign.Center)
        Spacer(Modifier.height(16.dp))

        // Сетка 3х3
        Column {
            for (row in 0..2) {
                Row {
                    for (col in 0..2) {
                        val index = row * 3 + col
                        val isSelected = selected.contains(index)
                        Box(
                            Modifier
                                .size(90.dp)
                                .padding(4.dp)
                                .border(2.dp, if (isSelected) Color.Red else Color.DarkGray)
                                .background(Color.Black)
                                .clickable {
                                    if (isSelected) selected.remove(index) else selected.add(index)
                                },
                            contentAlignment = Alignment.Center
                        ) {
                            StickFiguresCanvas(isAlone = index == 4) // В центре — одинокий силуэт
                        }
                    }
                }
            }
        }

        Spacer(Modifier.height(16.dp))
        if (errorText.isNotEmpty()) {
            Text(errorText, color = Color.Red, fontSize = 14.sp)
        }
        Spacer(Modifier.height(16.dp))

        Button(
            onClick = {
                errorText = "None found. Verification failed."
                onNext()
            },
            colors = ButtonDefaults.buttonColors(containerColor = Color.White)
        ) {
            Text("VERIFY", color = Color.Black)
        }
    }
}

@Composable
fun StickFiguresCanvas(isAlone: Boolean) {
    Canvas(Modifier.fillMaxSize()) {
        val cX = size.width / 2
        val cY = size.height / 2
        if (isAlone) {
            // Одинокий
            drawCircle(Color.White, radius = 8f, center = Offset(cX, cY - 20))
            drawLine(Color.White, Offset(cX, cY - 12), Offset(cX, cY + 20), strokeWidth = 5f)
            drawLine(Color.White, Offset(cX, cY + 20), Offset(cX - 10, cY + 45), strokeWidth = 5f)
            drawLine(Color.White, Offset(cX, cY + 20), Offset(cX + 10, cY + 45), strokeWidth = 5f)
        } else {
            // Пара с сердечком
            drawCircle(Color.White, radius = 6f, center = Offset(cX - 15, cY - 15))
            drawCircle(Color.White, radius = 6f, center = Offset(cX + 15, cY - 15))
            drawCircle(Color.Red, radius = 5f, center = Offset(cX, cY - 30))
            drawLine(Color.White, Offset(cX - 15, cY - 9), Offset(cX - 15, cY + 20), strokeWidth = 4f)
            drawLine(Color.White, Offset(cX + 15, cY - 9), Offset(cX + 15, cY + 20), strokeWidth = 4f)
            drawLine(Color.White, Offset(cX - 15, cY), Offset(cX + 15, cY), strokeWidth = 3f) // держатся за руки
        }
    }
}

