enum class Stage {
    START, GRID_LOVE, TEXT_LOVE, BIO_SCAN, CHECKLIST, CRASH_ERROR, RESISTANCE_CURSE
}

class MainActivity : ComponentActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val prefs = getSharedPreferences("horror_captcha", Context.MODE_PRIVATE)
        val isCursed = prefs.getBoolean("is_rejected_forever", false)

        setContent {
            var currentStage by remember { 
                mutableStateOf(if (isCursed) Stage.RESISTANCE_CURSE else Stage.START) 
            }

            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .background(Color(0xFF0F0F0F))
            ) {
                when (currentStage) {
                    Stage.START -> StartCaptchaScreen { currentStage = Stage.GRID_LOVE }
                    Stage.GRID_LOVE -> GridLoveScreen { currentStage = Stage.TEXT_LOVE }
                    Stage.TEXT_LOVE -> TextCaptchaScreen { currentStage = Stage.BIO_SCAN }
                    Stage.BIO_SCAN -> BioScanScreen { currentStage = Stage.CHECKLIST }
                    Stage.CHECKLIST -> ChecklistScreen { currentStage = Stage.CRASH_ERROR }
                    Stage.CRASH_ERROR -> CrashScreen { executeCurseAndCrash() }
                    Stage.RESISTANCE_CURSE -> TentaclesResistanceScreen {
                        triggerVibration(100)
                        finishAffinity()
                    }
                }
            }
        }
    }

    private fun triggerVibration(durationMs: Long) {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            val vm = getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as VibratorManager
            vm.vibrate(CombinedVibration.createParallel(
                VibrationEffect.createOneShot(durationMs, VibrationEffect.DEFAULT_AMPLITUDE)
            ))
        } else {
            @Suppress("DEPRECATION")
            val v = getSystemService(Context.VIBRATOR_SERVICE) as Vibrator
            v.vibrate(durationMs)
        }
    }

    private fun executeCurseAndCrash() {
        val prefs = getSharedPreferences("horror_captcha", Context.MODE_PRIVATE)
        prefs.edit().putBoolean("is_rejected_forever", true).apply()

        // Переключаем иконку
        val pm = packageManager
        pm.setComponentEnabledSetting(
            ComponentName(this, "$packageName.NormalAlias"),
            PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
            PackageManager.DONT_KILL_APP
        )
        pm.setComponentEnabledSetting(
            ComponentName(this, "$packageName.CursedAlias"),
            PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
            PackageManager.DONT_KILL_APP
        )

        triggerVibration(400)
        finishAffinity()
        exitProcess(0)
    }
}

