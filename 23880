@Composable
fun BioScanScreen(onNext: () -> Unit) {
    var scanning by remember { mutableStateOf(false) }
    var resultText by remember { mutableStateOf("") }

    LaunchedEffect(scanning) {
        if (scanning) {
            delay(1200)
            resultText = "Texts sent: 46\nTexts back: 0\nHugs this year: 0\nLast 'I love you': NEVER\n\nRESULT: ROBOT"
            delay(2500)
            onNext()
        }
    }

    Box(
        Modifier
            .fillMaxSize()
            .pointerInput(Unit) {
                detectTapGestures(
                    onPress = {
                        scanning = true
                        tryAwaitRelease()
                    }
                )
            },
        contentAlignment = Alignment.Center
    ) {
        Column(horizontalAlignment = Alignment.CenterHorizontally) {
            Text("BIOMETRIC HUMAN SCAN", color = Color.Gray, fontSize = 14.sp)
            Spacer(Modifier.height(20.dp))
            Box(
                Modifier
                    .size(100.dp)
                    .border(2.dp, if (scanning) Color.Red else Color.Cyan, RoundedCornerShape(50.dp)),
                contentAlignment = Alignment.Center
            ) {
                Text("HOLD", color = Color.White)
            }
            Spacer(Modifier.height(24.dp))
            Text(resultText, color = Color.Red, textAlign = TextAlign.Center, fontWeight = FontWeight.SemiBold)
        }
    }
}

@Composable
fun ChecklistScreen(onNext: () -> Unit) {
    val items = listOf("I'm not a robot", "I'm not alone", "I'm fine", "I'm lovable", "I'm not lonely")
    val checked = remember { mutableStateMapOf<Int, Boolean>() }

    Column(
        Modifier
            .fillMaxSize()
            .padding(24.dp),
        verticalArrangement = Arrangement.Center
    ) {
        Text("Confirm statements:", color = Color.White, fontSize = 20.sp)
        Spacer(Modifier.height(16.dp))

        items.forEachIndexed { i, text ->
            Row(
                Modifier
                    .fillMaxWidth()
                    .padding(vertical = 6.dp)
                    .background(Color(0xFF222222))
                    .clickable {
                        checked[i] = true
                        if (checked.size >= items.size) onNext()
                    }
                    .padding(14.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = if (checked[i] == true) "❌" else "⬜",
                    fontSize = 18.sp
                )
                Spacer(Modifier.width(12.dp))
                Text(text, color = Color.White, fontSize = 16.sp)
            }
        }
    }
}

