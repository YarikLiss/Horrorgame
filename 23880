// ------------------- ЩУПАЛЬЦА / ВЕНОМ ПРИ ВТОРОМ ЗАПУСКЕ -------------------

@Composable
fun TentaclesResistanceScreen(onComplete: () -> Unit) {
    val animProgress = remember { Animatable(0f) }

    LaunchedEffect(Unit) {
        animProgress.animateTo(
            targetValue = 1f,
            animationSpec = tween(durationMillis = 1600, easing = FastOutSlowInEasing)
        )
        delay(400)
        onComplete()
    }

    Box(Modifier.fillMaxSize().background(Color.Black)) {
        Canvas(Modifier.fillMaxSize()) {
            val p = animProgress.value
            val w = size.width
            val h = size.height

            // Процедурные темные щупальца, ползущие к центру
            val tentacleBranches = 16
            for (i in 0 until tentacleBranches) {
                val angle = (i.toFloat() / tentacleBranches) * (2 * Math.PI)
                val startX = (w / 2 + Math.cos(angle) * (w * 0.7f)).toFloat()
                val startY = (h / 2 + Math.sin(angle) * (h * 0.7f)).toFloat()

                val path = Path().apply {
                    moveTo(startX, startY)
                    cubicTo(
                        startX * (1 - p * 0.4f), startY * (1 - p * 0.4f),
                        w / 2 + (Random(i).nextFloat() - 0.5f) * 150f,
                        h / 2 + (Random(i * 2).nextFloat() - 0.5f) * 150f,
                        w / 2 * p + startX * (1 - p),
                        h / 2 * p + startY * (1 - p)
                    )
                }
                drawPath(path, color = Color(0xFF140202), style = Stroke(width = 30f * p))
                drawPath(path, color = Color.Red, style = Stroke(width = 4f * p))
            }
        }

        Column(
            Modifier.fillMaxSize(),
            verticalArrangement = Arrangement.Center,
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Text(
                "ВСЕ ЛЮБИМЫ.\nКРОМЕ ТЕБЯ.",
                color = Color.Red,
                fontSize = 28.sp,
                fontWeight = FontWeight.Black,
                textAlign = TextAlign.Center,
                lineHeight = 36.sp
            )
        }
    }
}