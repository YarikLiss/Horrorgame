<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="reCAPTCHA"
        android:roundIcon="@android:drawable/ic_dialog_info"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Основная активность -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize" />

        <!-- Обычный ярлык (по умолчанию включен) -->
        <activity-alias
            android:name=".NormalAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@android:drawable/ic_dialog_info"
            android:label="Human Verify"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Проклятый ярлык (включается в финале) -->
        <activity-alias
            android:name=".CursedAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@android:drawable/ic_delete"
            android:label="НЕ ТЫ"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>